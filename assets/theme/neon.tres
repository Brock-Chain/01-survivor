[resource]
default_font_size = 16
Button/colors/font_color = Color(0.8, 0.94, 1, 1)
Button/colors/font_focus_color = Color(0.97, 1, 1, 1)
Button/colors/font_hover_color = Color(0.97, 1, 1, 1)
