; Project-wide neon theme, wired via project.godot `gui/theme/custom`.
; One place defines the look so no screen can quietly ship default-theme
; controls (BRIEF.md acceptance criterion 12). Per the colour law, all chrome
; is the player's own instrument and therefore lives in the cyan family — the
; magenta/orange band stays reserved for things that can hurt you.
[gd_resource type="Theme" load_steps=6 format=3]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
content_margin_left = 14.0
content_margin_top = 10.0
content_margin_right = 14.0
content_margin_bottom = 12.0
bg_color = Color(0.05, 0.06, 0.13, 0.94)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.24, 0.52, 0.72, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

