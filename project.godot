[layer_names]

2d_physics/layer_1="player"
2d_physics/layer_2="enemies"
2d_physics/layer_3="projectiles"
2d_physics/layer_4="pickups"
2d_physics/layer_5="walls"
2d_physics/layer_6="enemy_projectiles"

[gui]

theme/custom="res://assets/theme/neon.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
; Playtest 2026-08-02: "the character is vibrating a bit, especially when moving
; diagonally". The viewport is 640x360 with NEAREST filtering, so a sprite sitting
; at a fractional position has its edges resolve to different pixels frame to
; frame - it shimmers. Diagonal movement is worst because both axes are fractional
; at once (0.707 * speed on each). The camera's position smoothing lands on
; fractions too, so everything shimmers relative to everything else.
;
; Snapping transforms to the pixel grid is the standard fix for a nearest-filtered
; pixel game and costs nothing. Motion becomes stepped at the viewport's
; resolution, which at 2x display scale is the intended look rather than a
; compromise.
; TRANSFORMS only, not vertices: vertex snapping would also quantise the trail
; ribbon and the lightning arcs, which are antialiased Line2Ds and are supposed
; to be smooth. Sprites snap, drawn geometry does not.
2d/snap/snap_2d_transforms_to_pixel=true
