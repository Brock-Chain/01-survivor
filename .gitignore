# Godot 4 editor cache — fully regenerated, never commit
.godot/

# Exported builds
/exports/
/builds/

# AI screenshot/debug scratch
/.ai/

# Godot 4.2+ temp GDExtension DLL copies
~*.dll

# Android .nomedia marker
.nomedia

# Export credentials (keystore passwords etc.) — export_presets.cfg itself IS committed
export_credentials.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# OS noise
Thumbs.db
Desktop.ini
.DS_Store

# Python bytecode from the tools/ scripts. Never ignored before, so it sat
# untracked-but-not-ignored in every `git status` — which is exactly how a
# `git add -A` ends up committing .pyc files nobody meant to ship.
__pycache__/
*.pyc

# Strudel render intermediates (the .ogg/.wav build artifacts under assets/ ARE
# committed; these are the renderer's raw output next to the sources)
audio_src/**/*.wav
audio_src/**/*.events.json
audio_src/**/*.import

# If the Strudel renderer is ever vendored into tools/strudel/, its dependencies
# are 67 MB of AGPL-3.0 packages and are never committed — package.json and
# package-lock.json declare them, `npm install` fetches them.
tools/strudel/node_modules/
