[gd_scene load_steps=16 format=3]

[ext_resource type="Script" path="res://scenes/player/player.gd" id="1_pl"]
[ext_resource type="Script" path="res://resources/stats.gd" id="2_st"]
[ext_resource type="Script" path="res://scenes/weapons/weapon.gd" id="3_wp"]
[ext_resource type="Texture2D" path="res://assets/sprites/player_body.png" id="4_tex"]
[ext_resource type="Script" path="res://scenes/player/game_camera.gd" id="5_cam"]
[ext_resource type="Script" path="res://scenes/weapons/orbital_weapon.gd" id="6_orb"]
[ext_resource type="Script" path="res://scenes/weapons/lance_weapon.gd" id="7_ln"]
[ext_resource type="Texture2D" path="res://assets/sprites/player_core.png" id="8_core"]

[sub_resource type="Resource" id="Resource_stats"]
resource_local_to_scene = true
script = ExtResource("2_st")

; Collision grew 10% with the sprite (12x14 -> 13x15, 14x16 -> 15x17). Playtest
; 2026-08-02 asked for a 10% larger player; leaving the hitbox behind would have
; made the character look bigger while being hit less, which is a lie.
[sub_resource type="RectangleShape2D" id="RectangleShape2D_body"]
size = Vector2(13, 15)

[sub_resource type="RectangleShape2D" id="RectangleShape2D_hurt"]
size = Vector2(15, 17)

[sub_resource type="CircleShape2D" id="CircleShape2D_magnet"]
resource_local_to_scene = true
radius = 48.0

; Trail taper. Points are ordered TAIL -> HEAD, so the curve runs thin at offset
; 0 and full width at offset 1: the ribbon is widest where it leaves the hexagon
; and dissolves behind you.
[sub_resource type="Curve" id="Curve_taper"]
_data = [Vector2(0, 0.08), 0.0, 0.0, 0, 0, Vector2(1, 1), 0.0, 0.0, 0, 0]
point_count = 2

[sub_resource type="Gradient" id="Gradient_trail"]
offsets = PackedFloat32Array(0, 1)
colors = PackedColorArray(0.42, 1, 0.98, 0, 0.55, 1, 0.99, 0.85)

[sub_resource type="Gradient" id="Gradient_jet"]
offsets = PackedFloat32Array(0, 1)
colors = PackedColorArray(0.35, 0.95, 1, 0, 0.85, 1, 1, 0.9)

[node name="Player" type="CharacterBody2D"]
collision_layer = 1
collision_mask = 18
script = ExtResource("1_pl")
stats = SubResource("Resource_stats")

; TRAIL. top_level so it lives in WORLD space - a trail parented to a moving
; player would drag along with them and never trail anything. Drawn behind both
; the body and the core.
[node name="Trail" type="Line2D" parent="."]
unique_name_in_owner = true
top_level = true
z_index = -3
width = 7.0
width_curve = SubResource("Curve_taper")
gradient = SubResource("Gradient_trail")
joint_mode = 2
begin_cap_mode = 2
end_cap_mode = 2
antialiased = true

[node name="JetA" type="Line2D" parent="."]
unique_name_in_owner = true
top_level = true
z_index = -2
width = 3.0
width_curve = SubResource("Curve_taper")
gradient = SubResource("Gradient_jet")
begin_cap_mode = 2
end_cap_mode = 2
antialiased = true

[node name="JetB" type="Line2D" parent="."]
unique_name_in_owner = true
top_level = true
z_index = -2
width = 3.0
width_curve = SubResource("Curve_taper")
gradient = SubResource("Gradient_jet")
begin_cap_mode = 2
end_cap_mode = 2
antialiased = true

[node name="Visual" type="Sprite2D" parent="."]
texture = ExtResource("4_tex")

; The core is a SEPARATE node so it can lag behind the shell under acceleration
; and carry state (hit, low HP, dash ready) without the body ever deforming.
[node name="Core" type="Sprite2D" parent="."]
unique_name_in_owner = true
z_index = 1
texture = ExtResource("8_core")

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
shape = SubResource("RectangleShape2D_body")

[node name="Hurtbox" type="Area2D" parent="."]
collision_layer = 0
collision_mask = 2
monitorable = false

[node name="CollisionShape2D" type="CollisionShape2D" parent="Hurtbox"]
shape = SubResource("RectangleShape2D_hurt")

[node name="Magnet" type="Area2D" parent="."]
collision_layer = 0
collision_mask = 8
monitorable = false

[node name="CollisionShape2D" type="CollisionShape2D" parent="Magnet"]
shape = SubResource("CircleShape2D_magnet")

[node name="Weapon" type="Node2D" parent="."]
script = ExtResource("3_wp")

[node name="Scattergun" type="Node2D" parent="."]
script = ExtResource("3_wp")

[node name="Lance" type="Node2D" parent="."]
script = ExtResource("7_ln")

[node name="Orbitals" type="Node2D" parent="."]
script = ExtResource("6_orb")

[node name="Camera2D" type="Camera2D" parent="."]
limit_left = 0
limit_top = 0
limit_right = 1280
limit_bottom = 720
position_smoothing_enabled = true
position_smoothing_speed = 8.0
script = ExtResource("5_cam")
