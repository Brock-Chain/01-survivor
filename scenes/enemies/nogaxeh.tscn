; THREE phases, where the Prism has two. Thresholds are HP fractions: alone and
; slow above 66%, mirroring the player above 33%, escorts plus the shield below.
[node name="Nogaxeh" type="CharacterBody2D" groups=["enemies"]]
collision_layer = 2
collision_mask = 19
script = ExtResource("1_ng")
boss_stats = ExtResource("4_stats")
