telegraph = 0.78
p1_interval = 2.2
p2_interval = 1.25
shard_orbit = 56.0
bolt_speed = 118.0

; Drawn only while dashing. top_level so it stays in world space instead of
; being dragged along by the boss it belongs to.
[node name="Trail" type="Line2D" parent="."]
