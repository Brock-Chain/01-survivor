[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://scenes/enemies/enemy_projectile.gd" id="1_ep"]
[ext_resource type="Texture2D" path="res://assets/sprites/bolt.png" id="2_tex"]

[sub_resource type="CircleShape2D" id="CircleShape2D_bolt"]
radius = 3.0

; Tail transparent, head opaque. Line2D maps offset 0 to the FIRST point and the
; newest position is appended LAST, so this reads oldest-to-newest.
[sub_resource type="Gradient" id="Gradient_trail"]
offsets = PackedFloat32Array(0, 1)
colors = PackedColorArray(1, 0.82, 0.3, 0, 1, 0.82, 0.3, 0.75)

; Additive, matching the halo. A mix-blended streak would DARKEN the floor grid
; it crosses — that is what a shadow does, not what a tracer does.
[sub_resource type="CanvasItemMaterial" id="CanvasItemMaterial_add"]
blend_mode = 1

[node name="EnemyProjectile" type="Area2D" groups=["enemy_projectiles"]]
collision_layer = 32
collision_mask = 1
script = ExtResource("1_ep")

; top_level so its points live in GLOBAL space. Parented into the bolt's
; transform the ribbon would be dragged along by the bolt and trail nothing —
; same construction, and same reason, as the player's trail.
[node name="Trail" type="Line2D" parent="."]
top_level = true
z_index = -1
width = 3.0
gradient = SubResource("Gradient_trail")
material = SubResource("CanvasItemMaterial_add")
begin_cap_mode = 2
end_cap_mode = 2
joint_mode = 2
antialiased = true

[node name="Visual" type="Sprite2D" parent="."]
texture = ExtResource("2_tex")

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
shape = SubResource("CircleShape2D_bolt")
