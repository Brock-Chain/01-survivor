[ext_resource type="Script" path="res://scenes/ui/true_ending.gd" id="1_true"]

; THE TRUE ENDING. Gold where the 5:00 victory screen is cyan-green, and a wider
; frame — at 640x360 the palette and the silhouette of the panel are what the
; player reads first, well before any of the text.
[node name="TrueEnding" type="CanvasLayer"]
process_mode = 2
visible = false
script = ExtResource("1_true")

; Darker than the victory screen's dim, and warm rather than cold.
