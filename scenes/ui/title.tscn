[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scenes/ui/title.gd" id="1_ti"]
[ext_resource type="Texture2D" path="res://assets/sprites/title_mark.png" id="2_hex"]

; Review finding 10: the title screen taught the WRONG GOAL ("Survive.") when the
; design's signature is winning at 5:00, and carried none of the game's visual
; identity — a bare wordmark with no shape on it, which for a game named after a
; shape is the whole miss. It is also the screenshot that earns the click before
; anyone plays a second of the game (BRIEF M1).
;
; The hexagon IS the logo now. It is the player's own sprite, scaled up and
; spinning slowly, so the first thing a stranger sees is the thing they are about
; to control.

