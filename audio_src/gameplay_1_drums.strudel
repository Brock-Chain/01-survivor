// == LAYER 1 - PULSE =========================================================
// Four-on-the-floor: the synthwave staple, and it doubles as the game's
// heartbeat. Hats sit OFF the beat - straight 8ths would plod; the offbeat is
// what gives the genre its lift.
//
// SYNTHESISED, NOT SAMPLED - same kit as track4_1_drums: s("bd") with no bank
// pulls Dirt-Samples (an acoustic/lo-fi kit), and .bank() is silently ignored
// by the renderer, so the 909 is built from oscillators and noise instead.
// penv is POSITIVE on purpose: superdough offsets the START upward and decays
// to the written note - exactly a drum's high-to-low sweep. Do not negate.
//
// Playtest note (2026-08-02): "there's a snare or two that feel like they are
// in the middle of nowhere". They were: the open-hat turnaround fired on the
// 4th and 3rd-and-4th sixteenths of bars 4 and 8, which reads as a mistake
// rather than a fill because it lands off the backbeat with nothing leading
// into it. Fills now sit on the LAST beat of the phrase and build INTO the
// downbeat, which is what makes a fill parse as intentional.
// Level-match note: gains set BY METER against the sampled stem's baseline
// (RMS -22.6 dBFS, peak 0.58) - filtered noise carries far more sustained
// energy than a sample at equal peak, so the old gains do not transfer.
setcps(0.5)
stack(
  // KICK - sine with a fast downward sweep: a0 + penv(26) starts near c3 and
  // falls to 27.5 Hz in 45 ms. Four on the floor, same drummer as before.
  note("a0*4").s("sine").penv(26).pdecay(0.045)
    .attack(0.001).decay(0.17).sustain(0)
    .distort("1.3:.5").gain(0.36),

  // CLAP backbeat on 2 and 4 - three noise bursts ~31 ms apart (the burst
  // train is what physically makes a clap a clap), plus a longer body under.
  s("~ [[white white white ~] ~ ~ ~] ~ [[white white white ~] ~ ~ ~]")
    .hpf(1100).lpf(6800).attack(0.001).decay(0.022).sustain(0).gain(0.28),
  s("~ white ~ white")
    .hpf(1000).lpf(5800).attack(0.012).decay(0.17).sustain(0)
    .gain(0.11).room(0.22).size(0.5),

  // Offbeat 8th hats - a closed hat is a hpf'd noise tick. No 16ths in this
  // track: the lift IS the offbeat.
  s("[~ white]*4").hpf(9200).attack(0.0005).decay(0.014).sustain(0)
    .gain(0.062).pan(sine.range(0.38, 0.62).fast(2)),

  // Turnaround: a 16th run on beat 4 of bars 4 and 8 - leading into the next
  // downbeat, never stranded mid-bar. Split into a hat voice and a snare
  // voice so each keeps its own filter and decay; event positions unchanged.
  s("<~ ~ ~ [~ ~ ~ [white white]] ~ ~ ~ [~ ~ [white white] ~]>")
    .hpf(9200).attack(0.0005).decay(0.014).sustain(0).gain(0.10),
  s("<~ ~ ~ ~ ~ ~ ~ [~ ~ ~ [white white]]>")
    .hpf(1500).lpf(8000).attack(0.001).decay(0.055).sustain(0).gain(0.26),

  // Open hat on the "and" of 4, every other bar: the classic lift. Lower hpf
  // and a long decay is the entire closed/open difference in filtered noise.
  s("<~ [~ ~ ~ [~ white]]>")
    .hpf(7600).attack(0.0005).decay(0.135).sustain(0).gain(0.11),

  // Crash marks the top of the loop - broadband noise, long tail, low-ish
  // hpf; filter a cymbal too high and all that is left is hiss.
  s("<white ~ ~ ~ ~ ~ ~ ~>")
    .hpf(3400).attack(0.002).decay(1.5).sustain(0)
    .gain(0.32).room(0.35).size(0.7)
)
