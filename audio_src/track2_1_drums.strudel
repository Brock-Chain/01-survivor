// == TRACK 2 - LAYER 1 - PULSE ===============================================
// Industrial, not synthwave. Three deliberate departures from the gameplay kit:
//   1. The kick is four-on-the-floor PLUS a syncopated hit on the "a" of 3.
//      That extra kick shoves beat 4 forward and is what makes the groove
//      feel like machinery rather than a dance floor.
//   2. Hats are straight 16ths, not offbeat 8ths. Offbeat 8ths lift; constant
//      16ths churn. This track wants churn.
//   3. Backbeat is snare AND clap stacked. Neither one alone is heavy enough;
//      together they read as a single wide industrial hit.
// Fills sit on the LAST beat of bars 4 and 8 and build INTO the downbeat --
// same rule the gameplay kit learned the hard way. A fill stranded mid-bar
// parses as a mistake.
//
// SYNTHESISED, NOT SAMPLED -- same port as track 4. Bare s("bd")/s("hh") pull
// Dirt-Samples (acoustic kit, and .bank() is silently ignored by the renderer),
// so the kit is oscillators and noise: sine+penv kick, noise burst clap, noise
// crack + tuned d3 body snare, filtered-noise hats/crash, square-clank metal.
// penv is POSITIVE on drums: it offsets the start UP and falls to the written
// note. Do not "fix" these to negative.
// Darker variant than track 4: heavier kick sweep (penv 28, longer decay) and
// the snare body sits on d3, the track's Phrygian root.
// Mix note: gains here are set BY METER against the pre-port stem (-23.8 dB
// RMS, 0.60 peak), not carried over from the old sample gains -- filtered
// noise carries far more sustained energy than a sample at equal peak.
setcps(0.5)
stack(
  // the floor -- sine with a fast downward sweep, distortion on the kick alone
  note("a0*4").s("sine").penv(28).pdecay(0.05)
    .attack(0.001).decay(0.19).sustain(0)
    .distort("1.3:.5").gain(0.267),

  // The machine push: extra kick on the "a" of beat 3, every bar.
  // Same voice, quieter -- kept at the original ghost/main ratio.
  note("[~ ~ [~ ~ ~ a0] ~]").s("sine").penv(28).pdecay(0.05)
    .attack(0.001).decay(0.19).sustain(0)
    .distort("1.3:.5").gain(0.165),

  // Stacked backbeat. Snare = noise crack + tuned d3 triangle body;
  // clap = three-burst noise train + longer reverb'd body underneath.
  s("~ white ~ white")
    .hpf(1500).lpf(8000).attack(0.001).decay(0.055).sustain(0).gain(0.32),
  note("~ d3 ~ d3").s("triangle").penv(9).pdecay(0.02)
    .attack(0.001).decay(0.085).sustain(0).gain(0.10),
  s("~ [[white white white ~] ~ ~ ~] ~ [[white white white ~] ~ ~ ~]")
    .hpf(1100).lpf(6800).attack(0.001).decay(0.022).sustain(0).gain(0.18),
  s("~ white ~ white")
    .hpf(1000).lpf(5800).attack(0.012).decay(0.17).sustain(0)
    .gain(0.06).room(0.22).size(0.5),

  // Constant 16th churn, panned narrow so it never distracts.
  s("white*16").hpf(9200).attack(0.0005).decay(0.014).sustain(0)
    .gain(0.04).pan(sine.range(0.38, 0.62).fast(4)),

  // Phrase turnarounds: beat 4 of bar 4 and of bar 8, always leading into the
  // next downbeat. Bar 8's is the longer of the two, because it hands the loop
  // back to the top.
  s(`<~ ~ ~ [~ ~ ~ [white white white white]]
      ~ ~ ~ [~ ~ [white white] [white white white white]]>`)
    .hpf(1500).lpf(8000).attack(0.001).decay(0.055).sustain(0).gain(0.16),

  // Open hat as the release valve at the end of each half-phrase.
  s("<~ ~ ~ [~ ~ ~ [~ white]] ~ ~ ~ [~ ~ ~ [~ white]]>")
    .hpf(7600).attack(0.0005).decay(0.135).sustain(0).gain(0.09),

  // Metal hit marks the top of the B section (bar 5) -- the only structural
  // signpost in the kit, so the player can feel the form without counting.
  // Industrial clank: square with a short pitch drop, hpf'd and distorted so
  // only the metallic upper partials survive.
  note("<~ ~ ~ ~ a6 ~ ~ ~>").s("square").penv(4).pdecay(0.012)
    .attack(0.0005).decay(0.05).sustain(0)
    .hpf(2500).distort("1.2:.5").gain(0.12),

  // top of the loop -- broadband noise, long tail
  s("<white ~ ~ ~ ~ ~ ~ ~>")
    .hpf(3400).attack(0.002).decay(1.5).sustain(0)
    .gain(0.15).room(0.35).size(0.7)
)
