// Enemy takes damage. A noise crack over a small pitch-thump — impact, not tone.
// Pitch-varied set: three centers so sustained fire never drills one frequency.
cat(
  stack(
    s("white").decay(.05).sustain(0).lpf(3800).gain(.7),
    note("e3").s("triangle").penv(5).pdecay(.05).decay(.06).sustain(0).gain(.9)
  ),
  stack(
    s("white").decay(.045).sustain(0).lpf(3200).gain(.7),
    note("d3").s("triangle").penv(5).pdecay(.05).decay(.06).sustain(0).gain(.9)
  ),
  stack(
    s("white").decay(.055).sustain(0).lpf(4400).gain(.7),
    note("f3").s("triangle").penv(5).pdecay(.05).decay(.06).sustain(0).gain(.9)
  )
)
